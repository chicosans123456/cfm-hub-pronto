    local btn = Instance.new("TextButton", frame)
    btn.Size = UDim2.new(0, 42, 0, 23)
    btn.Position = UDim2.new(1, -50, 0.5, -11.5)
    btn.BackgroundColor3 = default and Color3.fromRGB(125, 55, 225) or Color3.fromRGB(38, 33, 55)
