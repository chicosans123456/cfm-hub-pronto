-- ================= FUNÇÕES =================
local function IsNPC(model)
    if not model or not model:IsA("Model") then return false end
    if model == Character then return false end
    if Players:GetPlayerFromCharacter(model) then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("UpperTorso")
    return hum and hrp and hum.Health > 0
end

local function GetAllNPCs()
    local list = {}
    for _, obj in ipairs(workspace:GetChildren()) do
        if IsNPC(obj) then table.insert(list, obj) end
        if obj:IsA("Folder") or obj:IsA("Model") then
            for _, child in ipairs(obj:GetChildren()) do
                if IsNPC(child) then table.insert(list, child) end
            end
        end
    end
    return list
end

task.spawn(function()
    while ScreenGui.Parent do
        task.wait(0.12)
        if not (Config.KillAura or Config.AutoFarm or Config.AttackPlayers) then continue end
        Refresh()
        if not Root or not Character then continue end

        local function Hit(target)
            local hrp = target:FindFirstChild("HumanoidRootPart") or target:FindFirstChild("UpperTorso")
            local hum = target:FindFirstChildOfClass("Humanoid")
            if not hrp or not hum or hum.Health <= 0 then return end
            local dist = (hrp.Position - Root.Position).Magnitude
            if dist > Config.KillAuraRange then return end

            if Config.BringNPC then
                hrp.CFrame = Root.CFrame * CFrame.new(0, 0, -4)
            end

            if Config.SuperPunch then
                hum.Health = 0
                return
            end

            local tool = Character:FindFirstChildOfClass("Tool")
            if tool then pcall(function() tool:Activate() end) end
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton1(Vector2.new())
            end)
        end

        if Config.KillAura or Config.AutoFarm then
            for _, npc in ipairs(GetAllNPCs()) do
                Hit(npc)
            end
        end

        if Config.AttackPlayers then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    Hit(plr.Character)
                end
            end
        end
    end
end)

