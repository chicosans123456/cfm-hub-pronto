    local circle = Instance.new("Frame", btn)
    circle.Size = UDim2.new(0, 17, 0, 17)
    circle.Position = default and UDim2.new(1, -20, 0.5, -8.5) or UDim2.new(0, 3, 0.5, -8.5)
    circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    circle.BorderSizePixel = 0
    Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)

    local on = default
    btn.MouseButton1Click:Connect(function()
        on = not on
        btn.BackgroundColor3 = on and Color3.fromRGB(125, 55, 225) or Color3.fromRGB(38, 33, 55)
        circle.Position = on and UDim2.new(1, -20, 0.5, -8.5) or UDim2.new(0, 3, 0.5, -8.5)
        callback(on)
    end)
end

local function MakeSlider(tab, text, min, max, default, callback)
    local frame = Instance.new("Frame", tab.Page)
    frame.Size = UDim2.new(1, -6, 0, 52)
    frame.BackgroundColor3 = Color3.fromRGB(19, 15, 30)
    frame.BorderSizePixel = 0
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 7)

    local label = Instance.new("TextLabel", frame)
    label.Size = UDim2.new(1, -18, 0, 20)
    label.Position = UDim2.new(0, 11, 0, 4)
    label.BackgroundTransparency = 1
    label.Text = text .. ": " .. default
    label.TextColor3 = Color3.fromRGB(225, 205, 255)
    label.TextSize = 13
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left

    local bg = Instance.new("Frame", frame)
    bg.Size = UDim2.new(1, -22, 0, 7)
    bg.Position = UDim2.new(0, 11, 0, 32)
    bg.BackgroundColor3 = Color3.fromRGB(40, 30, 60)
    bg.BorderSizePixel = 0
    Instance.new("UICorner", bg).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame", bg)
    fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(145, 70, 255)
    fill.BorderSizePixel = 0
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local hold = false
    bg.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then hold = true end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then hold = false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if hold and i.UserInputType == Enum.UserInputType.MouseMovement then
            local rel = math.clamp((UserInputService:GetMouseLocation().X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
            local val = math.floor(min + (max - min) * rel)
            fill.Size = UDim2.new(rel, 0, 1, 0)
            label.Text = text .. ": " .. val
            callback(val)
        end
    end)
end

